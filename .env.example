# Banco Postgres (Neon). A integração "Neon" no painel do Vercel injeta esta variável.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Storage de imagens. A store de "Blob" no painel do Vercel injeta esta variável.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Auth.js: segredo de assinatura das sessões. Gere com: openssl rand -base64 33
AUTH_SECRET=

# OAuth do GitHub (Settings > Developer settings > OAuth Apps).
# Callback: https://SEU-DOMINIO/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# E-mails (da conta do GitHub) liberados para abrir /admin, separados por vírgula.
# Sem esta lista, nenhuma escrita é aceita em produção.
ADMIN_EMAILS=gukumagai@gmail.com
